{
  "name": "keybridge",
  "productName": "KeyBridge",
  "version": "1.1.3",
  "description": "Text shortcuts and hotkeys with left and right modifier keys, on every computer you sign in to",
  "main": "src/main/main.js",
  "author": "aiworldbyshachar",
  "homepage": "https://aiworldbyshachar.github.io/keybridge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiworldbyshachar/keybridge.git"
  },
  "bugs": "https://github.com/aiworldbyshachar/keybridge/issues",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "preview": "node dev/serve.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --test test/*.test.js",
    "helper": "cargo build --release --manifest-path native/Cargo.toml",
    "selftest": "native/target/release/keybridge-helper --selftest",
    "spike": "node dev/spike.js",
    "demo": "node dev/cli.js",
    "dist:win": "node scripts/cloud-config.js && electron-builder --win --publish never",
    "dist:mac": "bash scripts/mac-dmg.sh"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.keybridge.app",
    "productName": "KeyBridge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KeyBridge-Windows-Setup.${ext}",
      "extraResources": [
        {
          "from": "native/target/release/keybridge-helper.exe",
          "to": "keybridge-helper.exe"
        },
        {
          "from": "build/cloud.json",
          "to": "cloud.json"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KeyBridge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "KeyBridge-macOS.${ext}",
      "extendInfo": {
        "LSAppNapIsDisabled": true
      },
      "extraResources": [
        {
          "from": "native/target/universal/keybridge-helper",
          "to": "keybridge-helper"
        },
        {
          "from": "build/cloud.json",
          "to": "cloud.json"
        }
      ],
      "x64ArchFiles": "Contents/Resources/keybridge-helper"
    },
    "dmg": {
      "title": "KeyBridge"
    }
  }
}
